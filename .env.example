# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgres://user:password@host:5432/admissiondeck"
DIRECT_URL="postgres://superuser:password@host:5432/admissiondeck"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_COOKIE_DOMAIN=".admissiondeck.com"

NEXT_PUBLIC_ROOT_DOMAIN="crm.admissiondeck.com"
NEXT_PUBLIC_APP_URL="https://manage.admissiondeck.com"

# Optional integrations
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_QUARANTINE=""
R2_BUCKET_PRODUCTION=""
