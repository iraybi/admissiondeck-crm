generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrgKind {
  FIRM
  AGENCY
}

enum UserRole {
  PLATFORM_ADMIN
  FIRM_MANAGER
  AGENCY_MANAGER
  COUNSELLOR
  AGENT
  STUDENT
}

enum StudentStatus {
  LEAD
  ACTIVE
  OFFER
  VISA
  ENROLLED
  WITHDRAWN
  DROPOUT
  COMPLETED
  REFUSED
}

enum AppStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  OFFER
  OFFER_ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DocBucket {
  QUARANTINE
  PRODUCTION
  PURGED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  TIMEOUT
}

enum DocStatus {
  UPLOADED
  QUARANTINED
  AVAILABLE
  REJECTED
}

enum PayMethod {
  CHEQUE
  SWIFT
  BANK_TRANSFER
  CASH
  OTHER
}

enum PaymentState {
  PENDING
  AWAITING_PROOF
  IN_REVIEW
  VERIFIED
  REJECTED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Plan {
  ENTERPRISE_FIRM
  STANDARD_AGENCY
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum SslStatus {
  PENDING
  ISSUED
  FAILED
}

model Organization {
  id            String       @id @default(uuid())
  name          String
  identifier    String?   @unique
  displayName   String?
  kind          OrgKind
  // ltree path, e.g. org.chs.dhaka. Managed by application code and triggers.
  orgPath       String       @unique
  parentId      String?
  parent        Organization?       @relation("OrgTree", fields: [parentId], references: [id])
  children      Organization[]      @relation("OrgTree")

  customDomain  String?      @unique
  brandColor    String?
  logoUrl       String?
  website       String?
  supportEmail  String?
  phone         String?
  addressLine1  String?
  city          String?
  country       String?
  timezone      String       @default("UTC")
  currency      String       @default("BDT")

  seatsUsed     Int          @default(0)
  seatsBilled   Int          @default(10)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users         User[]
  students      Student[]
  leads         Lead[]
  subscription  Subscription?
  commissions   CommissionSchedule[]
  customDomains CustomDomain[]

  @@index([parentId])
  @@index([kind])
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  passwordHash       String?
  name               String
  avatarUrl          String?
  phone              String?

  role               UserRole
  orgId              String?
  org                Organization? @relation(fields: [orgId], references: [id])

  isActive           Boolean       @default(true)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  failedLogins       Int           @default(0)
  lockedUntil        DateTime?

  // MFA
  mfaEnabled         Boolean       @default(false)
  mfaSecret          String?
  mfaBackupCodes     String[]      @default([])
  mfaVerifiedAt      DateTime?

  // Password reset
  resetTokenHash     String?
  resetTokenExpires  DateTime?

  // Invite
  inviteTokenHash    String?
  inviteTokenExpires DateTime?
  invitedById        String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  sessions           Session[]
  auditLogs          AuditLog[]
  assignedStudents   Student[]     @relation("CounsellorStudents")
  referredStudents   Student[]     @relation("AgentStudents")
  uploadedDocuments  Document[]
  verifiedPayments   Payment[]
  tasks              Task[]
  notifications      Notification[]
  notes              Note[]
  transitions        StateTransition[]

  @@index([orgId, role])
  @@index([orgId, isActive])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, expiresAt])
}

model Student {
  id                String        @id @default(uuid())
  orgId             String
  org               Organization  @relation(fields: [orgId], references: [id])
  userId            String?       @unique
  counsellorId      String?
  counsellor        User?         @relation("CounsellorStudents", fields: [counsellorId], references: [id])
  agentId           String?
  agent             User?         @relation("AgentStudents", fields: [agentId], references: [id])
  referringAgencyId String?

  name              String
  email             String
  phone             String?
  passportNumber    String?
  dateOfBirth       DateTime?
  nationality       String?

  // Denormalized for RLS: "<agency orgPath>.<student id>"
  orgPath           String

  targetCountry     String
  targetUniversity  String?
  targetProgram     String?
  targetIntake      String?
  status            StudentStatus @default(LEAD)
  pipelineTemplateId String?
  pipelineTemplate  PipelineTemplate? @relation(fields: [pipelineTemplateId], references: [id])

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  applications      Application[]
  documents         Document[]
  payments          Payment[]
  notes             Note[]
  tasks             Task[]
  leads             Lead[]

  @@index([orgId, status])
  @@index([counsellorId])
  @@index([agentId])
  @@index([targetCountry])
  @@index([createdAt])
}

model PipelineTemplate {
  id        String           @id @default(uuid())
  country   String           @unique
  name      String
  stages    Json
  docs      Json
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  students  Student[]
}

model Application {
  id           String    @id @default(uuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  programId    String
  program      Program   @relation(fields: [programId], references: [id])
  intakeId     String?
  status       AppStatus @default(DRAFT)
  submittedAt  DateTime?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  offers       Offer[]
  payments     Payment[]

  @@index([studentId, status])
  @@index([universityId])
}

model University {
  id        String    @id @default(uuid())
  name      String
  country   String
  city      String?
  website   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  programs  Program[]
  applications Application[]
  offers    Offer[]
  commissions CommissionSchedule[]

  @@index([country])
  @@index([name])
}

model Program {
  id           String   @id @default(uuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  name         String
  level        String   // BACHELOR | MASTER | DIPLOMA | PHD
  durationMonths Int?
  tuitionAmount  Decimal? @db.Decimal(12, 2)
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  applications   Application[]
  offers         Offer[]
  commissions    CommissionSchedule[]
  intakes        Intake[]

  @@index([universityId, level])
}

model Intake {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  term      String   // e.g. Fall 2026
  startDate DateTime
  deadline  DateTime?
  isActive  Boolean  @default(true)

  @@index([programId, term])
}

model Offer {
  id            String   @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  universityId  String
  university    University @relation(fields: [universityId], references: [id])
  programId     String
  program       Program  @relation(fields: [programId], references: [id])
  status        String   @default("ISSUED") // ISSUED | ACCEPTED | REJECTED | EXPIRED
  amount        Decimal? @db.Decimal(12, 2)
  currency      String   @default("USD")
  conditions    Json?
  issuedAt      DateTime @default(now())
  expiresAt     DateTime?
  respondedAt   DateTime?

  @@index([applicationId])
}

model Document {
  id               String     @id @default(uuid())
  studentId        String
  student          Student    @relation(fields: [studentId], references: [id])
  orgPath          String
  type             String
  fileName         String
  storageKey       String
  bucket           DocBucket  @default(QUARANTINE)
  scanStatus       ScanStatus @default(PENDING)
  scanResult       Json?
  status           DocStatus  @default(UPLOADED)
  uploadedById     String
  uploadedBy       User       @relation(fields: [uploadedById], references: [id])
  sizeBytes        Int
  mimeType         String
  sha256           String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  payments         Payment[]

  @@index([studentId, type])
  @@index([scanStatus, status])
  @@index([createdAt])
}

model Payment {
  id               String       @id @default(uuid())
  studentId        String
  student          Student      @relation(fields: [studentId], references: [id])
  orgPath          String
  applicationId    String?
  application      Application? @relation(fields: [applicationId], references: [id])
  proofDocumentId  String?
  proofDocument    Document?    @relation(fields: [proofDocumentId], references: [id])

  title            String
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("BDT")
  method           PayMethod    @default(OTHER)
  state            PaymentState @default(PENDING)
  milestone        String?
  dueAt            DateTime?
  verifiedById     String?
  verifiedBy       User?        @relation(fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  rejectReason     String?
  reference        String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([studentId, state])
  @@index([orgPath, state])
  @@index([dueAt])
}

model StateTransition {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  fromState  String?
  toState    String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  orgPath    String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([orgPath, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model Subscription {
  id                   String        @id @default(uuid())
  orgId                String        @unique
  org                  Organization  @relation(fields: [orgId], references: [id])
  plan                 Plan
  seatQuantity         Int           @default(10)
  status               SubStatus     @default(INCOMPLETE)
  notes                String?       // operator notes for manual billing
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([plan])
  @@index([status])
}

model CommissionSchedule {
  id           String    @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  programId    String?
  program      Program?  @relation(fields: [programId], references: [id])
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])

  rate         Decimal   @db.Decimal(5, 4)
  platformCut  Decimal   @db.Decimal(5, 4) @default(0)
  holdingCut   Decimal   @db.Decimal(5, 4) @default(0)
  originCut    Decimal   @db.Decimal(5, 4) @default(0)
  agentCut     Decimal   @db.Decimal(5, 4) @default(0)
  referralCut  Decimal   @db.Decimal(5, 4) @default(0)
  holdbackDays Int       @default(0)
  clawbackPolicy String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([orgId, programId, universityId])
}

model Lead {
  id                 String     @id @default(uuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id])
  orgPath            String
  counsellorId       String?
  agentId            String?
  studentId          String?
  student            Student?   @relation(fields: [studentId], references: [id])

  name               String
  email              String
  phone              String?
  source             String?
  targetCountry      String?
  targetProgram      String?
  status             LeadStatus @default(NEW)
  convertedStudentId String?

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([orgId, status])
  @@index([counsellorId])
  @@index([agentId])
}

model Note {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, createdAt])
}

model Task {
  id          String     @id @default(uuid())
  orgPath     String
  studentId   String?
  student     Student?   @relation(fields: [studentId], references: [id])
  assigneeId  String
  assignee    User       @relation(fields: [assigneeId], references: [id])
  title       String
  description String?
  dueAt       DateTime?
  status      TaskStatus @default(OPEN)
  priority    Priority   @default(MEDIUM)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([assigneeId, status])
  @@index([dueAt])
  @@index([studentId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model CustomDomain {
  id         String    @id @default(uuid())
  hostname   String    @unique
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  pathPrefix String?   // e.g. "/students" for path-based mapping
  portal     String    @default("student") // which portal this domain serves
  verifiedAt DateTime?
  dnsToken   String
  sslStatus  SslStatus @default(PENDING)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([hostname])
  @@index([orgId])
  @@index([hostname, pathPrefix])
}

enum DocScope {
  GLOBAL
  COUNTRY
  UNIVERSITY
  PROGRAMME
  INTAKE
  STUDENT
}

model DocumentRequirement {
  id          String   @id @default(uuid())
  scope       DocScope
  scopeId     String?  // country name, university id, programme id, intake id, or student id
  docType     String   // PASSPORT | IELTS | BANK_STATEMENT | or custom
  label       String   // display name
  description String?
  isRequired  Boolean  @default(true)
  maxFiles    Int      @default(1)
  allowedMimes String[] @default(["application/pdf", "image/png", "image/jpeg"])
  maxBytes    Int      @default(15728640) // 15MB
  sortOrder   Int      @default(0)
  validDays   Int?     // expiry window in days
  conditions  Json?    // e.g. { "ageMax": 18, "funding": "self" }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, scopeId])
  @@index([docType])
  @@index([isActive])
}
